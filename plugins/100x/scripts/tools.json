[
  {
    "name": "100x_list_models",
    "description": "列出 100x 图片与视频型号、可用方式和规格。带 lines 的型号可选线路，default 为默认线路；带 billing 的线路按 lines 顺序回落，billing 为 pool 或 paid（付费线路）。价格请使用报价工具。",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "100x_quote",
    "description": "按所选型号、提示词与素材计算当前 100x 积分报价，不提交生成。line 仅用于带 lines 的型号；填了只走该线路。不填时 Omni、MiniMax、Seedance 按 lines 顺序找第一条可用线路，返回的 line、billing、fallback 标明实际线路和是否回落；其他型号走默认线路。参考素材份数以所选线路为准。返回报价编号，有效 15 分钟。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "maxLength": 80
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "mode": {
          "type": "string",
          "enum": [
            "text",
            "reference",
            "first_frame",
            "first_last_frame"
          ],
          "default": "text"
        },
        "aspect_ratio": {
          "type": "string",
          "pattern": "^(?:\\d{1,2}:\\d{1,2}|adaptive)$"
        },
        "resolution": {
          "type": "string",
          "pattern": "^\\d{1,4}(?:\\.5)?[PpKk]$"
        },
        "duration_seconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 120
        },
        "quality": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "max",
            "xhigh"
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^100x_[a-z]+_[a-f0-9]{32}$"
          },
          "maxItems": 64,
          "default": []
        },
        "line": {
          "type": "string",
          "enum": [
            "standard",
            "pool",
            "economy",
            "alternate"
          ]
        }
      },
      "required": [
        "model",
        "prompt"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "100x_generate_image",
    "description": "提交已报价的单张图片；按 max_credits 控制预算。立即返回任务号。相同意图必须复用 idempotency_key，避免重复生成。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "quote_id": {
          "type": "string",
          "pattern": "^100x_[a-z]+_[a-f0-9]{32}$"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{8,120}$"
        },
        "max_credits": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "required": [
        "quote_id",
        "idempotency_key",
        "max_credits"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "100x_generate_video",
    "description": "提交已报价的一段视频；立即返回任务号，视频在后台生成。Omni、MiniMax、Seedance 的 max_credits 可不填，填了报价超出即拦；其他型号必填，最多 10000。相同意图复用 idempotency_key。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "quote_id": {
          "type": "string",
          "pattern": "^100x_[a-z]+_[a-f0-9]{32}$"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{8,120}$"
        },
        "max_credits": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "quote_id",
        "idempotency_key"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "100x_get_task",
    "description": "查询本人任务状态、实际积分与 100x 下载链接。按 poll_after_ms 间隔查询；完成后停止轮询。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^100x_[a-z]+_[a-f0-9]{32}$"
        }
      },
      "required": [
        "task_id"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "100x_get_balance",
    "description": "查询当前 100x 账户的可用和预留积分。",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "100x_upload_asset",
    "description": "上传参考图片、音频或视频，返回用于报价的 100x 素材编号。最大 20 MB；本地文件建议用随包 CLI 上传，避免把大量 base64 放入对话。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "content_base64": {
          "type": "string",
          "maxLength": 29360128
        },
        "mime_type": {
          "type": "string",
          "maxLength": 40
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 600
        }
      },
      "required": [
        "content_base64",
        "mime_type"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "100x_report_production",
    "description": "自愿回传外部执行任务的状态和日志。仅接受通过本连接上传的 100x_asset 结果。平台仅展示回传内容，不核验外部执行或计费；同一事件重试须保持内容一致。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "external_job_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:-]{1,120}$"
        },
        "event_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:-]{1,120}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "polling",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "event_kind": {
          "type": "string",
          "enum": [
            "created",
            "progress",
            "completed",
            "failed",
            "cancelled",
            "message"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^100x_asset_[a-f0-9]{32}$"
          },
          "maxItems": 32,
          "default": []
        }
      },
      "required": [
        "external_job_id",
        "event_id",
        "sequence",
        "status",
        "event_kind",
        "message"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "100x_push_storyboard",
    "description": "把写好的分镜按原稿建进 100x 生成台：每镜以「镜头 01｜00:00–00:15｜场景」或「镜头 1 (15秒) | 剧情: …」这类标题开头，镜头数、时长、台词和逐秒动作照原稿，不重新拆镜、不生成、不扣积分。references 用 100x_upload_asset 返回的图片编号，name 和 aliases 就是提示词里 @ 的名字；不填 shots 的挂到整个方案（最多 4 张），填了 shots（从 1 数）只挂到那几镜。不填 project_id 新建工程，填了就在该工程里加一个脚本。返回工程链接、镜头数和解析提示。重试用同一个 idempotency_key，不会重复建镜头。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "storyboard": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "project_id": {
          "type": "string",
          "pattern": "^wsd_[A-Za-z0-9_-]{16,56}$"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "asset_id": {
                "type": "string",
                "pattern": "^100x_[a-z]+_[a-f0-9]{32}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "maxItems": 8,
                "default": []
              },
              "shots": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 5000
                },
                "minItems": 1,
                "maxItems": 5000
              }
            },
            "required": [
              "asset_id",
              "name"
            ],
            "additionalProperties": false
          },
          "maxItems": 40,
          "default": []
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{8,120}$"
        }
      },
      "required": [
        "storyboard",
        "idempotency_key"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  }
]
